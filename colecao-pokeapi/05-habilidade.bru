meta {
  name: 05 - Habilidade: header e resposta JSON
  type: http
  seq: 5
}

get {
  url: https://pokeapi.co/api/v2/ability/1
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  // EXERCICIO 5 - VERIFIQUE STATUS, HEADER E CORPO.
  test('Resposta HTTP 200', () => {
    expect(res.getStatus()).to.equal(200);
  });

  test('Content-Type indica JSON', () => {
    expect(res.getHeader('content-type')).to.include('application/json');
  });

  test('A habilidade possui id e nome', () => {
    const body = res.getBody();
    expect(body.id).to.equal(1);
    expect(body.name).to.be.a('string').that.is.not.empty;
  });
}
